@PACKAGE_INIT@

foreach(comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    find_package(${comp} QUIET CONFIG
        PATHS "${CMAKE_CURRENT_LIST_DIR}/../${comp}"
        NO_DEFAULT_PATH
    )
    set(${CMAKE_FIND_PACKAGE_NAME}_${comp}_FOUND "${${comp}_FOUND}")
    if(NOT ${comp}_FOUND AND ${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_${comp})
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "Required component '${comp}' not found. ${${comp}_NOT_FOUND_MESSAGE}")
    endif()
endforeach()

check_required_components(PopupUI)
