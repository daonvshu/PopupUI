@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Gui Widgets)
find_dependency(DialogAnimations CONFIG
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../DialogAnimations"
    NO_DEFAULT_PATH
)

include("${CMAKE_CURRENT_LIST_DIR}/DialogShadowTargets.cmake")
